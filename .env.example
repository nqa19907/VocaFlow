# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Project Settings > API keys > Publishable key (legacy anon key also works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reserved for account deletion in a later milestone. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Milestone 4: server-only AI configuration; unused in milestone 1.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
# Set trial credits in private.app_config in PostgreSQL before creating accounts.
# Google login remains hidden unless the provider is enabled in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
